{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "base-black",
					"color": "#14110d",
					"name": "Workshop Black"
				},
				{
					"slug": "base-ink",
					"color": "#1c1a16",
					"name": "Walnut Ink"
				},
				{
					"slug": "base-mid",
					"color": "#6b6153",
					"name": "Oak Mid"
				},
				{
					"slug": "base-rule",
					"color": "#e4d6bc",
					"name": "Shavings Rule"
				},
				{
					"slug": "base-ground",
					"color": "#f5e8d0",
					"name": "Shop Floor"
				},
				{
					"slug": "base-paper",
					"color": "#fbf3e4",
					"name": "Sawdust Paper"
				},
				{
					"slug": "base-accent",
					"color": "#8d5c1d",
					"name": "Shellac Amber"
				},
				{
					"slug": "base-accent-tint",
					"color": "#f4e3c8",
					"name": "Amber Tint"
				}
			],
			"gradients": []
		},
		"typography": {
			"fluid": true,
			"customFontSize": false,
			"defaultFontSizes": false,
			"lineHeight": true,
			"letterSpacing": true,
			"textTransform": true,
			"textDecoration": true,
			"fontFamilies": [
				{
					"name": "Baloo 2",
					"slug": "serif",
					"fontFamily": "'Baloo 2', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Baloo 2", "fontWeight": "400 800", "fontStyle": "normal", "src": [ "file:./assets/fonts/baloo-2/baloo-2-variable.woff2" ] }
					]
				},
				{
					"name": "Mulish",
					"slug": "sans",
					"fontFamily": "Mulish, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Mulish", "fontWeight": "200 1000", "fontStyle": "normal", "src": [ "file:./assets/fonts/mulish/mulish-variable.woff2" ] },
						{ "fontFamily": "Mulish", "fontWeight": "200 1000", "fontStyle": "italic", "src": [ "file:./assets/fonts/mulish/mulish-variable-italic.woff2" ] }
					]
				},
				{
					"name": "Monospace",
					"slug": "mono",
					"fontFamily": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{ "fontFamily": "IBM Plex Mono", "fontWeight": "400", "fontStyle": "normal", "src": [ "file:./assets/fonts/ibm-plex-mono/ibm-plex-mono-400.woff2" ] },
						{ "fontFamily": "IBM Plex Mono", "fontWeight": "500", "fontStyle": "normal", "src": [ "file:./assets/fonts/ibm-plex-mono/ibm-plex-mono-500.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{
					"name": "2X-Small",
					"slug": "2xs",
					"size": "0.6875rem",
					"fluid": false
				},
				{
					"name": "X-Small",
					"slug": "xs",
					"size": "clamp(0.75rem, 0.72rem + 0.15vw, 0.875rem)",
					"fluid": {
						"min": "0.75rem",
						"max": "0.875rem"
					}
				},
				{
					"name": "Small",
					"slug": "sm",
					"size": "clamp(0.875rem, 0.83rem + 0.22vw, 1rem)",
					"fluid": {
						"min": "0.875rem",
						"max": "1rem"
					}
				},
				{
					"name": "Base",
					"slug": "base",
					"size": "clamp(1rem, 0.96rem + 0.22vw, 1.125rem)",
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					}
				},
				{
					"name": "Medium",
					"slug": "md",
					"size": "clamp(1.125rem, 1.07rem + 0.28vw, 1.25rem)",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"name": "Large",
					"slug": "lg",
					"size": "clamp(1.25rem, 1.17rem + 0.42vw, 1.5rem)",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"name": "X-Large",
					"slug": "xl",
					"size": "clamp(1.5rem, 1.37rem + 0.65vw, 1.875rem)",
					"fluid": {
						"min": "1.5rem",
						"max": "1.875rem"
					}
				},
				{
					"name": "2X-Large",
					"slug": "2xl",
					"size": "clamp(1.875rem, 1.67rem + 1.04vw, 2.5rem)",
					"fluid": {
						"min": "1.875rem",
						"max": "2.5rem"
					}
				},
				{
					"name": "3X-Large",
					"slug": "3xl",
					"size": "clamp(2.25rem, 1.93rem + 1.63vw, 3.25rem)",
					"fluid": {
						"min": "2.25rem",
						"max": "3.25rem"
					}
				},
				{
					"name": "Display",
					"slug": "display",
					"size": "clamp(3rem, 2.35rem + 3.26vw, 5rem)",
					"fluid": {
						"min": "3rem",
						"max": "5rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "1", "slug": "1", "size": "0.25rem" },
				{ "name": "2", "slug": "2", "size": "0.5rem" },
				{ "name": "3", "slug": "3", "size": "0.75rem" },
				{ "name": "4", "slug": "4", "size": "1rem" },
				{ "name": "5", "slug": "5", "size": "1.5rem" },
				{ "name": "6", "slug": "6", "size": "2rem" },
				{ "name": "7", "slug": "7", "size": "2.5rem" },
				{ "name": "8", "slug": "8", "size": "3rem" },
				{ "name": "9", "slug": "9", "size": "4rem" },
				{ "name": "10", "slug": "10", "size": "5rem" },
				{ "name": "11", "slug": "11", "size": "6.5rem" },
				{ "name": "12", "slug": "12", "size": "8rem" },
				{ "name": "20", "slug": "20", "size": "12rem" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"custom": {
			"kerf-light": "#fbf3e4",
			"kerf-dark": "#14110d",
			"kerf-accent": "#8d5c1d"
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": false
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base-paper)",
			"text": "var(--wp--preset--color--base-ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--6)"
		},
		"elements": {
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--3-xl)",
					"fontWeight": "800",
					"lineHeight": "1.05",
					"letterSpacing": "-0.01em"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--2-xl)",
					"fontWeight": "700",
					"lineHeight": "1.1",
					"letterSpacing": "-0.01em"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--xl)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--md)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--sm)",
					"fontWeight": "600",
					"letterSpacing": "0.05em",
					"textTransform": "uppercase"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--xs)",
					"fontWeight": "600",
					"letterSpacing": "0.08em",
					"textTransform": "uppercase"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--base-accent)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--base-black)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "700"
				},
				"color": {
					"background": "var(--wp--preset--color--base-black)",
					"text": "var(--wp--preset--color--base-paper)"
				}
			}
		},
		"blocks": {
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--sm)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--lg)",
					"fontWeight": "400"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--sm)"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--base-rule)"
				},
				"border": {
					"color": "var(--wp--preset--color--base-rule)"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--xl)",
					"lineHeight": "1.3"
				},
				"border": {
					"color": "var(--wp--preset--color--base-accent)",
					"width": "3px"
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)"
				},
				"border": {
					"color": "var(--wp--preset--color--base-rule)",
					"style": "solid",
					"width": "0 0 0 3px"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-wide",
			"title": "Page (wide)",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-blank",
			"title": "Page (no header/footer)",
			"postTypes": [ "page" ]
		}
	]
}
